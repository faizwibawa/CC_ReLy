# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Base URL of the deployed ReLy API (the Lambda Function URL printed by
# infrastructure/deploy.sh), WITHOUT a trailing slash.
RELY_API_URL=https://<your-function-url-id>.lambda-url.us-east-1.on.aws

# Same URL for the mobile web app (Vite only exposes variables prefixed VITE_).
VITE_API_BASE_URL=https://<your-function-url-id>.lambda-url.us-east-1.on.aws

# Simulator options
RELY_SIM_SEED_FILE=simulator/signals_seed.json
RELY_SIM_RESYNC_SECONDS=60
